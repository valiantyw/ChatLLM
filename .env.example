# 把本文件复制为 `.env`，只填写你实际使用的厂商。
# 每个厂商都需要同时提供 API key 与端点变量；代码中没有任何硬编码的端点默认值。
# 已存在的进程环境变量优先级高于本文件。

# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# QuickRouter
QUICKROUTER_API_KEY=your_quickrouter_api_key
QUICKROUTER_BASE_URL=https://api.quickrouter.ai/v1

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-xxxx_your_nvidia_api_key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
